# Copy to server/.env (git-ignored) and fill in real values.
PORT=4000
CORS_ORIGIN=http://localhost:8081
MONGODB_URI=mongodb://localhost:27017/app

# Generate a strong random secret with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-string-at-least-32-characters-long
JWT_ACCESS_EXPIRES_IN_SECONDS=3600
JWT_REFRESH_EXPIRES_IN_SECONDS=604800

# Issue photos (optional; without them POST /api/uploads/signature returns 503).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
