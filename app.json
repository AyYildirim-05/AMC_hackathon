{
  "expo": {
    "name": "Montone",
    "slug": "Montone",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/montone-icon.png",
    "scheme": "montone",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/montone-icon.png",
      "bundleIdentifier": "com.yildirim.cuneyt.it.Montone",
      "buildNumber": "2",
      "infoPlist": {
        "CFBundleLocalizations": ["en", "fr"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/montone-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.yildirim.cuneyt.it.Montone",
      "versionCode": 2
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F2F2",
          "image": "./assets/images/montone-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#181716",
            "image": "./assets/images/montone-icon.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "fr"],
            "android": ["en", "fr"]
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Montone uses your camera to photograph the issues you report.",
          "photosPermission": "Montone uses your photo library to attach photos to the issues you report.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Montone uses your location to pinpoint civic issues and identify your Montreal borough."
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
